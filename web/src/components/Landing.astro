---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { copy, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/issacbrizuela1/PUB-P-APP-ROUTEHOUND';
const kofi = 'https://ko-fi.com/issacb';
const routes = [['GET', '/users'], ['POST', '/users'], ['PUT', '/users/:id'], ['DELETE', '/users/:id']];
const heart = 'M12 20s-7-4.4-9.2-8.6C1.2 8.2 3.1 4.5 6.6 4.5c2.1 0 3.6 1.2 5.4 3.2 1.8-2 3.3-3.2 5.4-3.2 3.5 0 5.4 3.7 3.8 6.9C19 15.6 12 20 12 20z';
const enUrl = getRelativeLocaleUrl('en');
const esUrl = getRelativeLocaleUrl('es');
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{c.title}</title>
  <meta name="description" content={c.description}>
  <meta property="og:title" content={c.title}>
  <meta property="og:description" content={c.description}>
  <meta property="og:image" content={new URL(`${base}logo.png`, Astro.site)}>
  <link rel="icon" type="image/png" href={`${base}favicon.png`}>
  <link rel="alternate" hreflang="en" href={new URL(enUrl, Astro.site)}>
  <link rel="alternate" hreflang="es" href={new URL(esUrl, Astro.site)}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap">
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
  </script>
</head>
<body>
  <header class="topbar">
    <nav class="wrap nav" aria-label={c.navMain}>
      <a class="brand" href={lang === 'en' ? enUrl : esUrl}>
        <img src={`${base}logo.png`} alt="" width="28" height="28">
        <span>Routehound</span>
      </a>
      <div class="nav-links">
        <a href="#features">{c.navFeatures}</a>
        <a href="#compare">{c.navCompare}</a>
        <a href={repo}>GitHub</a>
      </div>
      <div class="nav-tools">
        <div class="seg" role="group" aria-label={c.language}>
          <a href={enUrl} aria-current={lang === 'en' ? 'true' : undefined} hreflang="en">EN</a>
          <a href={esUrl} aria-current={lang === 'es' ? 'true' : undefined} hreflang="es">ES</a>
        </div>
        <button class="btn btn-secondary icon-btn" type="button" id="theme-toggle" aria-label={c.themeLabel}>
          <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        </button>
        <a class="btn btn-secondary" href={kofi}>
          <svg class="heart" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d={heart}></path></svg>
          <span>Ko-fi</span>
        </a>
      </div>
    </nav>
  </header>

  <main id="top">
    <section class="wrap hero">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1>{c.h1}</h1>
      <p class="lead">{c.sub}</p>
      <div class="ctas">
        <a class="btn btn-primary btn-lg" href={`${repo}/releases/latest`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M4 20h16"></path></svg>
          <span>{c.download}</span>
        </a>
        <a class="btn btn-secondary btn-lg" href={kofi}>
          <svg class="heart" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d={heart}></path></svg>
          <span>{c.kofi}</span>
        </a>
      </div>
      <p class="small muted">{c.soon}</p>
      <div class="routes">
        <span class="muted">{c.indexed}</span>
        {routes.map(([method, path]) => (
          <span class="route"><span class="method-badge" data-method={method}>{method}</span><span>{path}</span></span>
        ))}
      </div>
    </section>

    <section class="wrap demo" aria-label="Demo">
      <figure class="window">
        <div class="window-bar">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="mono small muted">Routehound · examples/express-demo</span>
        </div>
        <img src={`${base}demo.gif`} alt={c.demoAlt} width="1440" height="900" loading="lazy">
      </figure>
      <p class="caption small muted">{c.demoCaption}</p>
    </section>

    <section id="features" class="wrap block">
      <h2>{c.featuresTitle}</h2>
      <p class="muted intro">{c.featuresSub}</p>
      <div class="cards">
        {c.features.map(([title, text], i) => (
          <article class="card">
            <span class="num">0{i + 1}</span>
            <h3>{title}</h3>
            <p class="muted">{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="compare" class="wrap block">
      <h2>{c.compareTitle}</h2>
      <div class="table-box">
        <table>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">{c.feature}</span></th>
              <th scope="col" class="us">Routehound</th>
              <th scope="col">Bruno</th>
              <th scope="col">Postman</th>
            </tr>
          </thead>
          <tbody>
            {c.rows.map(([label, ...cells]) => (
              <tr>
                <th scope="row">{label}</th>
                {cells.map(([mark, note], i) => (
                  <td class={i === 0 ? 'us' : undefined}>
                    <span class={`mark ${mark}`}>{c.marks[mark]}</span>
                    {note && <span class="note muted"> {note}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="wrap block support" aria-labelledby="support-title">
      <div class="support-box">
        <div class="support-text">
          <svg class="heart" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d={heart}></path></svg>
          <h2 id="support-title">{c.supportTitle}</h2>
          <p class="muted">{c.supportText}</p>
        </div>
        <a class="btn btn-primary btn-lg" href={kofi}>{c.supportBtn}</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-row small muted">
      <span class="grow">© 2026 Routehound · {c.license}</span>
      <a href={repo}>GitHub</a>
      <a href={`${repo}/releases`}>{c.releases}</a>
      <a href={kofi}>Ko-fi</a>
    </div>
  </footer>

  <script is:inline>
    document.getElementById('theme-toggle').addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme
        ? root.dataset.theme === 'dark'
        : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    });
  </script>
</body>
</html>

<style is:global>
  /* Palette: the app's tokens (Routehound src/assets/css/main.css). Do not invent colors. */
  :root {
    color-scheme: light;
    --background: #f6f4ef;
    --surface: #ffffff;
    --foreground: #1b1b1f;
    --muted: #5f6772;
    --border: #e3e0d8;
    --accent: #0f766e;
    --primary-foreground: #ffffff;
    --destructive: #d4183d;
    --heart: var(--destructive);
    --success-fg: #0b7a52;
    --warning: #b96c10;
    --warning-fg: #8a4f08;
    --danger-fg: #a3122f;
    --put: #1f4f9a;
    --patch: #5b3a8f;
    --post: var(--warning-fg);
    --font-sans: 'IBM Plex Sans', sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark;
      --background: #0b0f14;
      --surface: #0f1722;
      --foreground: #e6edf5;
      --muted: #9aa7b6;
      --border: #223042;
      --accent: #2dd4bf;
      --primary-foreground: #0b0f14;
      --heart: #f28b9f;
      --success-fg: #0f9a68;
      --warning-fg: #f0b45c;
      --danger-fg: #f28b9f;
      --put: #8fb6f2;
      --patch: #c3a6ef;
      --post: #f0b45e;
    }
    :root:not([data-theme='light']) .i-sun { display: block; }
    :root:not([data-theme='light']) .i-moon { display: none; }
  }
  :root[data-theme='dark'] {
    color-scheme: dark;
    --background: #0b0f14;
    --surface: #0f1722;
    --foreground: #e6edf5;
    --muted: #9aa7b6;
    --border: #223042;
    --accent: #2dd4bf;
    --primary-foreground: #0b0f14;
    --heart: #f28b9f;
    --success-fg: #0f9a68;
    --warning-fg: #f0b45c;
    --danger-fg: #f28b9f;
    --put: #8fb6f2;
    --patch: #c3a6ef;
    --post: #f0b45e;
  }
  :root[data-theme='dark'] .i-sun { display: block; }
  :root[data-theme='dark'] .i-moon { display: none; }
  .i-sun { display: none; }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--background);
    color: var(--foreground);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.55;
    text-rendering: optimizeLegibility;
  }
  a { color: inherit; }
  img { max-width: 100%; }
  ::selection { background: color-mix(in srgb, var(--accent) 28%, transparent); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .muted { color: var(--muted); }
  .small { font-size: 13px; }
  .mono { font-family: var(--font-mono); }
  .grow { flex-grow: 1; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .wrap { max-width: 1120px; margin: 0 auto; padding-inline: clamp(16px, 4vw, 32px); }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 38px; padding: 0 14px; border: 1px solid transparent; border-radius: 6px;
    font: inherit; font-size: 14px; font-weight: 500; text-decoration: none; cursor: pointer;
    transition: transform 0.12s ease, background-color 0.12s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn-lg { height: 48px; padding: 0 22px; font-size: 16px; font-weight: 600; }
  .btn-primary { background: var(--accent); color: var(--primary-foreground); border-color: var(--accent); }
  .btn-primary:hover { background: color-mix(in srgb, var(--accent) 85%, black); border-color: color-mix(in srgb, var(--accent) 85%, black); }
  .btn-secondary { background: color-mix(in srgb, var(--surface) 85%, var(--border)); color: var(--foreground); border-color: var(--border); }
  .btn-secondary:hover { background: color-mix(in srgb, var(--surface) 70%, var(--border)); }
  .btn-lg.btn-secondary { font-weight: 500; }
  .icon-btn { width: 44px; padding: 0; }
  .heart { stroke: var(--heart); }

  .topbar { border-bottom: 1px solid var(--border); }
  .nav { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding-block: 14px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 700; font-size: 17px; letter-spacing: -0.01em; }
  .brand img { border-radius: 6px; }
  .nav-links { display: flex; flex-wrap: wrap; gap: 4px 18px; flex-grow: 1; font-size: 14px; color: var(--muted); }
  .nav-links a { text-decoration: none; padding: 10px 0; }
  .nav-links a:hover { color: var(--foreground); }
  .nav-tools { display: flex; align-items: center; gap: 8px; }
  .seg { display: flex; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; font-family: var(--font-mono); font-size: 12px; }
  .seg a { min-width: 44px; height: 36px; display: flex; align-items: center; justify-content: center; text-decoration: none; color: var(--muted); }
  .seg a + a { border-left: 1px solid var(--border); }
  .seg a[aria-current] { color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }

  .hero { padding-block: clamp(48px, 9vw, 104px) 40px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; color: var(--accent); border: 1px solid var(--border); border-radius: 999px; padding: 4px 12px; background: var(--surface); }
  .hero h1 { margin: 0; max-width: 820px; font-size: clamp(38px, 6.4vw, 68px); line-height: 1.05; letter-spacing: -0.03em; }
  .lead { margin: 0; max-width: 640px; font-size: clamp(17px, 2vw, 19px); color: var(--muted); }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 6px; }
  .hero > p.small { margin: 0; }
  .routes { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px; margin-top: 18px; font-family: var(--font-mono); font-size: 12px; }
  .routes > .muted { margin-right: 4px; }
  .route { display: flex; align-items: center; gap: 6px; border: 1px solid var(--border); background: var(--surface); border-radius: 6px; padding: 4px 8px 4px 4px; }
  .method-badge {
    display: inline-flex; align-items: center; justify-content: center; min-width: 52px; height: 20px; padding: 0 4px;
    border-radius: 4px; font-family: var(--font-mono); font-size: 11px; font-weight: 600;
    background: color-mix(in srgb, var(--accent) 10%, transparent); color: var(--accent);
  }
  .method-badge[data-method='POST'] { background: color-mix(in srgb, var(--warning) 14%, transparent); color: var(--post); }
  .method-badge[data-method='PUT'] { background: color-mix(in srgb, #2f6fd1 14%, transparent); color: var(--put); }
  .method-badge[data-method='PATCH'] { background: color-mix(in srgb, #7b56b8 14%, transparent); color: var(--patch); }
  .method-badge[data-method='DELETE'] { background: color-mix(in srgb, var(--destructive) 12%, transparent); color: var(--danger-fg); }

  .demo { padding-block: 24px; }
  .window { margin: 0; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--surface); }
  .window-bar { height: 36px; display: flex; align-items: center; gap: 8px; padding: 0 14px; border-bottom: 1px solid var(--border); }
  .window-bar .mono { margin-left: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dot { width: 10px; height: 10px; flex: none; border-radius: 50%; background: var(--border); }
  .window img { display: block; width: 100%; height: auto; }
  .caption { margin: 14px 0 0; text-align: center; font-size: 14px; }

  .block { padding-block: 88px 24px; }
  .block h2 { margin: 0 0 10px; font-size: clamp(28px, 3.6vw, 40px); letter-spacing: -0.02em; line-height: 1.15; }
  #compare h2 { margin-bottom: 28px; }
  .intro { margin: 0 0 36px; max-width: 620px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 16px; }
  .card { border: 1px solid var(--border); background: var(--surface); border-radius: 8px; padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 8px; }
  .card h3 { margin: 0; font-size: 18px; letter-spacing: -0.01em; }
  .card p { margin: 0; font-size: 15px; }
  .num { font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: var(--accent); }

  .table-box { overflow-x: auto; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); }
  table { width: 100%; min-width: 680px; border-collapse: collapse; font-size: 15px; }
  thead th { text-align: left; font-family: var(--font-mono); font-size: 13px; font-weight: 500; color: var(--muted); padding: 14px 18px; border-bottom: 1px solid var(--border); }
  thead th.us { color: var(--accent); font-weight: 600; }
  tbody th { text-align: left; font-weight: 500; padding: 14px 18px; border-top: 1px solid var(--border); }
  tbody td { padding: 14px 18px; border-top: 1px solid var(--border); }
  td.us { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .mark { font-weight: 600; }
  .mark.yes { color: var(--success-fg); }
  .mark.partial { color: var(--warning-fg); }
  .mark.no { color: var(--muted); }
  .note { font-size: 13px; }

  .support { padding-bottom: 96px; }
  .support-box { border: 1px solid var(--border); background: var(--surface); border-radius: 12px; padding: clamp(28px, 5vw, 48px); display: flex; flex-wrap: wrap; align-items: center; gap: 24px 40px; }
  .support-text { flex: 999 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .support-text h2 { margin: 0; font-size: clamp(24px, 3vw, 32px); }
  .support-text p { margin: 0; max-width: 560px; }
  .support-box .btn { flex: 1 1 auto; }

  .footer { border-top: 1px solid var(--border); }
  .footer-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding-block: 28px 36px; font-size: 14px; }
  .footer-row a { padding: 10px 0; }
</style>
